# ─── App ───────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development            # development | staging | production
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_APP_ENV=development
API_URL=http://localhost:4000
TZ=UTC                         # store in UTC, display Asia/Jerusalem

# ─── Database / Redis ──────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Meta / WhatsApp Cloud API ─────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=
META_SYSTEM_USER_TOKEN=        # dev/staging test number only

# ─── AI providers ──────────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET_PER_TENANT=

# ─── Email / files / payments ──────────────────────────
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PAYMENT_GATEWAY=               # cardcom | tranzila | grow | payplus ...
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ─── Observability ─────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Marketing / tracking — NEXT_PUBLIC_* are public IDs, never secrets ───
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=   # AW-XXXX/label
NEXT_PUBLIC_TRACKING_TEST_MODE=0
META_CAPI_ACCESS_TOKEN=        # server-side only
META_CAPI_TEST_EVENT_CODE=     # non-production only

# ─── Agents service ────────────────────────────────────
AGENTS_URL=http://localhost:4100

# ─── Design (developer machine only — NOT in .env files of the repo) ───
# STITCH_API_KEY is read by Cursor from your shell/OS environment for .cursor/mcp.json
